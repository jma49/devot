+
+// Siblings are visited in order, so the search starts next to the last index
+// found in a list: `indexOf` alone made a visit quadratic in a parent's children.
+const lastIndexes = new WeakMap()
+
+function indexIn(children, node) {
+  const last = lastIndexes.get(children)
+  let index = -1
+  if (last !== undefined) {
+    if (children[last + 1] === node) index = last + 1
+    else if (children[last] === node) index = last
+    else if (children[last - 1] === node) index = last - 1
+  }
+  if (index === -1 && last !== undefined) index = children.indexOf(node, last + 1)
+  if (index === -1) index = children.indexOf(node)
+  lastIndexes.set(children, index)
+  return index
+}
