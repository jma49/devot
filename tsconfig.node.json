{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node"],
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/core",
    "plugin-kit/src",
    "plugin-kit/types",
    "plugins",
    "src/renderer/src/build.d.ts",
    "relay/src/node",
    "licence/scripts",
    "tests",
    "scripts",
    "vite.config.ts",
    "vite.ui-test.config.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ],
  "exclude": ["tests/ui", "tests/ui-csp"]
}
