{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "semi": false,
  "printWidth": 100,
  "ignorePatterns": [
    "dist/**",
    "pnpm-lock.yaml",
    "src-tauri/target/**",
    "src-tauri/gen/**",
    "playwright-report/**",
    "test-results/**",
    "src/renderer/src/theme/tokens.*",
    "tests/core/fixtures/html-import/**"
  ]
}
