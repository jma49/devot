        "general": { "$value": "{color.tile.general}", "$type": "color" },
        "appearance": { "$value": "{color.tile.appearance}", "$type": "color" },
        "editing": { "$value": "{color.tile.editing}", "$type": "color" },
        "preview": { "$value": "{color.tile.preview}", "$type": "color" },
