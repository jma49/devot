{
  "$description": "System theme, dark appearance. Devot's own blue palette by default; Settings > Appearance can make the accent follow the macOS accent colour instead.",
  "$extensions": {
    "app.devot": {
      "theme": "system",
      "appearance": "dark"
    }
  },
  "color": {
    "surface": {
      "sidebar": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.0902, 0.0902, 0.0902],
          "hex": "#171717",
          "alpha": 0.7
        },
        "$extensions": {
          "app.devot": {
            "material": "sidebar"
          }
        }
      },
      "sidebar-opaque": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.0902, 0.0902, 0.0902],
          "hex": "#171717"
        },
        "$description": "The sidebar when the window material is turned off (Settings > Appearance): the material tint, opaque."
      },
      "list": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.0667, 0.0667, 0.0667],
          "hex": "#111111"
        },
        "$description": "hsl(0 0% 9% / 50%) over the editor, opaque."
      },
      "editor": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.0392, 0.0392, 0.0392],
          "hex": "#0a0a0a"
        }
      },
      "popover": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.1647, 0.1608, 0.1529],
          "hex": "#2a2927"
        },
        "$description": "Floating lists in the editor: the slash menu and the completion popups."
      }
    },
