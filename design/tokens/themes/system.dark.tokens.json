        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.9804, 0.9804, 0.9804],
          "hex": "#fafafa"
        },
        "$description": "The one colour every text tier is drawn from: each color.text tier is this colour at its tier's strength over the editor (`tier` in its extensions), moved toward white only where contrast needs it."
      },
      "line": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.9608, 0.9608, 0.9608],
          "hex": "#f5f5f5"
