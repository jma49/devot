          "colorSpace": "srgb",
          "components": [0.9529, 0.9569, 0.9647],
          "hex": "#f3f4f6"
        },
        "$description": "The sidebar when the window material is turned off (Settings > Appearance), and the sidebar of the Settings window."
      },
      "list": {
        "$type": "color",
