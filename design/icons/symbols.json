{
  "$description": "Devot icon names mapped to SF Symbols. The app renders them at runtime through AppKit (the symbol_png command). No symbol artwork is stored in this repository.",
  "symbols": {
    "notes.all": "note.text",
    "notes.pinned": "pin",
    "note.pinned": "pin.fill",
    "tag.remove": "xmark",
    "notebook": "book.closed",
    "notebook.new": "plus",
    "notebook.ai": "sparkles",
    "trash": "trash",
    "templates": "doc.on.doc",
    "status.active": "play.circle.fill",
    "status.onHold": "pause.circle.fill",
    "status.completed": "checkmark.circle.fill",
    "status.dropped": "xmark.circle.fill",
    "tag": "circle.fill",
    "sidebar.toggle": "sidebar.left",
    "note.new": "square.and.pencil",
    "mode.focus": "arrow.up.left.and.arrow.down.right",
    "mode.focus.exit": "arrow.down.right.and.arrow.up.left",
    "mode.edit": "pencil",
    "mode.split": "rectangle.split.2x1",
    "mode.preview": "eye",
    "more": "ellipsis.circle",
    "search": "magnifyingglass",
    "popup": "chevron.up.chevron.down",
    "disclosure.open": "chevron.down",
    "disclosure.closed": "chevron.right",
    "sort": "arrow.up.arrow.down",
    "progress": "checklist",
    "date.created": "clock",
    "date.updated": "calendar",
    "callout.note": "info.circle",
    "check": "checkmark",
    "format.heading": "textformat.size",
    "format.bold": "bold",
    "format.italic": "italic",
    "format.strikethrough": "strikethrough",
    "format.highlight": "highlighter",
    "format.link": "link",
    "format.code": "chevron.left.forwardslash.chevron.right",
    "history": "clock.arrow.circlepath",
    "nav.back": "chevron.left",
    "nav.forward": "chevron.right",
    "find.previous": "chevron.up",
    "find.next": "chevron.down",
    "format.codeBlock": "curlybraces.square",
    "format.bulletList": "list.bullet",
    "format.numberedList": "list.number",
    "format.taskList": "checklist",
    "format.quote": "text.quote",
    "format.alert": "exclamationmark.bubble",
    "code.copy": "doc.on.doc",
    "code.copied": "checkmark",
    "code.copyFailed": "exclamationmark.triangle",
    "filter": "line.3.horizontal.decrease"
  }
}
