{
  "name": "devot",
  "version": "0.0.0",
  "private": true,
  "description": "A local-first Markdown note-taking app for macOS.",
  "homepage": "https://github.com/jma49/devot#readme",
  "bugs": {
    "url": "https://github.com/jma49/devot/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jma49/devot.git"
  },
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "pnpm tauri build",
    "build:debug": "pnpm tauri build --debug --config src-tauri/tauri.debug.conf.json",
    "ui:dev": "vite",
    "ui:build": "vite build",
    "ui:release": "node scripts/sentry/ui.ts",
    "sentry:debug-files": "node scripts/sentry/debug-files.ts",
    "mcp:build": "vite build --config vite.mcp.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc -p relay/tsconfig.json",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:fast": "vitest run --project fast",
    "test:watch": "vitest",
    "test:ui": "playwright test",
    "rust:check": "cd src-tauri && cargo fmt --check && cargo clippy --all-targets -- -D warnings && cargo test && cargo deny check",
    "deps:audit": "pnpm audit --audit-level=high",
    "check": "pnpm tokens:check && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:ui && pnpm deps:audit && pnpm rust:check",
    "tauri": "PATH=\"$(pwd)/scripts/shims:$PATH\" tauri",
    "smoke:quit": "bash scripts/smoke/quit-saves.sh",
    "tokens": "node scripts/tokens/build.ts",
    "app-icon": "sh scripts/app-icon/build.sh",
    "grammars": "node scripts/preview/grammars.ts && oxfmt src/core/preview/grammars.ts",
    "tokens:check": "node scripts/tokens/build.ts --check",
    "bench": "node scripts/bench/run.ts",
    "bench:app": "bash scripts/bench/app.sh"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@lezer/common": "1.5.3",
    "@lezer/highlight": "1.2.5",
    "@lezer/markdown": "1.8.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@sentry/browser": "11.6.0",
    "@tauri-apps/api": "2.12.2",
    "better-sqlite3": "13.0.3",
    "comlink": "4.4.2",
    "gemoji": "8.1.0",
    "hast-util-from-html": "2.0.3",
    "hast-util-sanitize": "5.0.2",
    "hast-util-to-html": "9.0.5",
    "hast-util-to-mdast": "10.1.2",
    "highlight.js": "11.11.1",
    "lowlight": "3.3.0",
    "lucide-react": "^1.61.0",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-math": "3.0.0",
    "mdast-util-to-markdown": "2.2.0",
    "mermaid": "12.1.0",
    "property-information": "7.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "temml": "0.14.0",
    "unified": "11.0.5",
    "y-codemirror.next": "0.3.6",
    "yaml": "2.9.1",
    "yjs": "13.6.33",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@sentry/cli": "3.8.0",
    "@tauri-apps/cli": "2.12.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/node": "^24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",
    "fast-check": "4.10.2",
    "lefthook": "2.2.1",
    "miniflare": "4.20260730.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.10.1"
}
