{
  "about": "Plugin manifest cases run by tests/core/plugin-manifest.test.ts and src-tauri/src/plugins/manifest.rs. Each case is the base with its patch's keys set on top (null removes a key). appVersions: whether a minAppVersion runs on an app version, which only Rust decides.",
  "base": {
    "id": "com.example.word-count",
    "name": "Word Count",
    "version": "1.2.0",
    "apiVersion": 1,
    "description": "Counts words.",
    "author": "Example",
    "main": "main.js",
    "permissions": ["note.read", "commands", "menus", "keymaps"],
    "contributes": {
      "commands": [{ "id": "count", "title": "Count Words" }],
      "menus": [{ "command": "count" }],
      "keymaps": [{ "command": "count", "key": "Mod+Shift+U" }]
    }
  },
  "valid": [
    {
      "name": "a command in the slash menu from API version 2",
      "patch": {
        "apiVersion": 2,
        "permissions": ["note.edit", "commands"],
        "contributes": {
          "commands": [{ "id": "bold", "title": "Bold" }],
          "slashMenu": [{ "command": "bold" }]
        }
      }
    },
    { "name": "the base", "patch": {} },
    {
      "name": "no optional fields",
      "patch": { "description": null, "author": null, "permissions": null, "contributes": null }
    },
    { "name": "a main script in a folder", "patch": { "main": "dist/plugin.min.js" } },
    { "name": "a one-part id", "patch": { "id": "wordcount" } },
    { "name": "a minimum app version", "patch": { "minAppVersion": "1.1.7" } },
    { "name": "API version 2", "patch": { "apiVersion": 2 } },
    {
      "name": "notes.read from API version 2",
      "patch": { "apiVersion": 2, "permissions": ["notes.read"], "contributes": null }
    },
    {
      "name": "storage from API version 2",
      "patch": { "apiVersion": 2, "permissions": ["storage"], "contributes": null }
    },
    {
      "name": "every kind of setting",
      "patch": {
        "apiVersion": 2,
        "permissions": null,
        "contributes": {
          "settings": [
            { "id": "on", "title": "On", "type": "toggle", "default": true },
            {
              "id": "label",
              "title": "Label",
              "type": "text",
              "default": "Total",
              "description": "Shown first."
            },
            { "id": "size", "title": "Size", "type": "number", "default": 12, "min": 8, "max": 32 },
            { "id": "ratio", "title": "Ratio", "type": "number", "default": 0.5 },
            {
              "id": "unit",
              "title": "Unit",
              "type": "choice",
              "default": "mi",
              "choices": [
                { "id": "km", "title": "Kilometres" },
                { "id": "mi", "title": "Miles" }
              ]
            }
          ]
        }
      }
    },
    { "name": "unknown keys are left out", "patch": { "homepage": "https://example.com" } },
    {
      "name": "every contribution",
      "patch": {
        "permissions": [
          "note.read",
          "note.edit",
          "commands",
          "menus",
          "keymaps",
          "preview",
          "import",
          "export"
        ],
        "contributes": {
          "commands": [
            { "id": "count", "title": "Count Words" },
            { "id": "upper-case", "title": "Upper Case" }
          ],
          "menus": [{ "command": "upper-case" }],
          "keymaps": [{ "command": "count", "key": "Mod+Alt+ArrowUp" }],
          "previewRenderers": [
            { "id": "chart", "language": "chart" },
            { "id": "csv", "language": "c++.csv" }
          ],
          "importFormats": [{ "id": "org", "title": "Org Files", "extensions": ["org", "txt"] }],
          "exportFormats": [{ "id": "org", "title": "Org", "extension": "org" }]
        }
      }
    }
  ],
