{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Devot",
  "identifier": "io.github.jma49.devot",
  "build": {
    "beforeDevCommand": "pnpm vite",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm ui:release",
    "beforeBundleCommand": "pnpm sentry:debug-files",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Devot",
        "width": 1280,
        "height": 820,
        "minWidth": 760,
        "minHeight": 480,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 20, "y": 28 },
        "windowEffects": { "effects": ["underWindowBackground"], "state": "active" }
      }
    ],
    "security": {
      "freezePrototype": true,
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' data: blob: devot: https:",
        "font-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost https://*.ingest.us.sentry.io",
        "frame-src": "'self' https:",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline' http://localhost:5173",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: devot: https:",
        "font-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost http://localhost:5173 ws://localhost:5173",
        "frame-src": "'self' https:",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      }
    }
  },
  "plugins": {
    "deep-link": { "desktop": { "schemes": ["devot"] } }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns"],
    "macOS": { "minimumSystemVersion": "26.0" },
    "resources": { "cli/devot": "bin/devot" }
  }
}
