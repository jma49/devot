    "allow-ai-settings-get",
    "allow-sync-get",
    "allow-sync-connect",
    "allow-sync-pull",
    "allow-sync-push",
    "allow-sync-disconnect",
    "allow-sync-status-report",
    "allow-sync-pending",
    "allow-sync-read",
    "allow-sync-entry-put",
    "allow-sync-state-get",
    "allow-sync-state-put",
