{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "phone",
  "description": "Permissions for the iPhone's one window, whose Settings tab shows the Settings panes in place: the editor settings, fonts, the keyboard shortcuts, the local usage events, the AI providers (the key only goes in), Sync (pairing, joining, devices and status, the recovery key until it is saved), the licence and its Buy page, the App Store's products, a purchase and Restore Purchases (which answer only in an App Store build), and copying to the clipboard. iOS only: the Mac keeps these in its Settings window. Add a command here only when a phone settings pane needs it.",
  "platforms": ["iOS"],
  "windows": ["main"],
  "permissions": [
    "allow-editor-settings-get",
    "allow-editor-settings-set",
    "allow-crash-reports-set",
    "allow-fonts-list",
    "allow-fonts-installed",
    "allow-font-read",
    "allow-usage-list",
    "allow-usage-clear",
    "allow-keyboard-shortcuts-get",
    "allow-keyboard-shortcuts-set",
    "allow-settings-ai-access-summary",
    "allow-ai-settings-get",
    "allow-ai-settings-set",
    "allow-ai-key-set",
    "allow-ai-key-clear",
    "allow-sync-get",
    "allow-sync-set",
    "allow-sync-vault-create",
    "allow-sync-recovery-key",
    "allow-sync-recovery-saved",
    "allow-sync-pairing-open",
    "allow-sync-pairing-check",
    "allow-sync-pairing-cancel",
    "allow-sync-join-code",
    "allow-sync-join-recovery",
    "allow-sync-devices",
    "allow-sync-usage",
    "allow-sync-device-remove",
    "allow-sync-icloud-status",
    "allow-sync-icloud-use",
    "allow-sync-icloud-upload-again",
    "allow-licence-get",
    "allow-licence-set",
    "allow-licence-remove",
    "allow-licence-refresh",
    "allow-store-products",
    "allow-store-purchase",
    "allow-store-restore",
    "allow-open-external",
    "allow-clipboard-write-text",
    "allow-clipboard-write-secret"
  ]
}
