{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "note-window",
  "description": "Permissions for a note window (one note, in a window of its own): reading and writing notes and their versions and attachments through its own core, relaying its changes to the other windows, naming itself after the note, and saving before it closes or the app quits. No notebooks, tags, imports, exports, backups or settings changes: those stay in the main window.",
  "windows": ["note-*"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-set-title",
    "allow-symbol-png",
    "allow-system-accent",
    "allow-clipboard-write-text",
    "allow-clipboard-read-text",
    "allow-text-look-up",
    "allow-text-speak",
    "allow-editor-menu-popup",
    "allow-notes-list",
    "allow-note-get",
    "allow-notes-bodies",
    "allow-note-put",
    "allow-tags-list",
    "allow-revision-put",
    "allow-revisions-list",
    "allow-revision-get",
    "allow-revisions-delete",
    "allow-file-put",
    "allow-image-copy",
    "allow-image-save",
    "allow-open-external",
    "allow-link-title",
    "allow-github-snippet",
    "allow-log-write",
    "allow-editor-settings-get",
    "allow-font-read",
    "allow-keyboard-shortcuts-get",
    "allow-app-exit-ready",
    "allow-app-exit-cancel",
    "allow-note-relay-send",
    "allow-note-window-open",
    "allow-note-window-note",
    "allow-note-window-close-ready",
    "allow-note-window-close-cancel"
  ]
}
