        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The folder is not empty. Devot adds its files beside the ones there and never changes or deletes a file it did not write; a file that already holds exactly what Devot would write is taken as Devot’s."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
