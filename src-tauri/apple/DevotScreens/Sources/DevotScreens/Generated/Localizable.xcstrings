    "sync.advice.circuit" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A note kept changing back and forth between devices. Turn Sync This Device off and on in Settings > Sync to try again."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有一篇笔记在设备之间反复来回变化。请在“设置 > 同步”中关闭再打开“同步这台设备”以重试。"
          }
        }
      }
    },
    "sync.advice.moved" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This vault now syncs another way. Set up sync again in Settings > Sync to follow it."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这个保险库现在改用其他方式同步。请在“设置 > 同步”中重新设置以跟随它。"
          }
        }
      }
    },
    "sync.advice.protocol" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Update Devot and your relay to the same release."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请把 Devot 和你的中继更新到同一个版本。"
          }
        }
      }
    },
    "sync.advice.restoreChoice" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A backup was restored here: choose in the main window whether to merge or keep this Mac’s copy."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这里恢复了一份备份：请在主窗口中选择合并，还是保留这台 Mac 上的副本。"
          }
        }
      }
    },
    "sync.advice.rotated" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The vault key was changed on another device. Join again in Settings > Sync with a pairing code or the new recovery key."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保险库密钥已在另一台设备上更换。请在“设置 > 同步”中用配对码或新的恢复密钥重新加入。"
          }
        }
      }
    },
    "sync.notice.clock" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sync is paused: this device’s clock is more than 5 minutes off. Set the date and time automatically to sync again."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同步已暂停：这台设备的时钟偏差超过 5 分钟。请设为自动设置日期与时间以重新同步。"
          }
        }
      }
    },
    "sync.notice.icloudAccountChanged" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sync has stopped: this device is signed in to another Apple ID than the one your vault syncs through on iCloud. In Settings > Sync, move the vault into this Apple ID or turn sync off."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同步已停止：这台设备登录的 Apple 账户与你的保险库在 iCloud 上同步所用的不同。请在“设置 > 同步”中把保险库移到这个 Apple 账户，或关闭同步。"
          }
        }
      }
    },
    "sync.notice.icloudDeleted" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sync has stopped: your vault’s data was removed from iCloud. In Settings > Sync, upload it again from this device or turn sync off."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同步已停止：你的保险库数据已从 iCloud 中删除。请在“设置 > 同步”中从这台设备重新上传，或关闭同步。"
          }
        }
      }
    },
    "sync.notice.icloudFull" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sync is paused: your iCloud storage is full, so changes from this device are not syncing. Free up iCloud storage or get more in System Settings > Apple Account > iCloud; sync goes on by itself after that."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同步已暂停：你的 iCloud 存储空间已满，所以这台设备上的修改没有同步。请在“系统设置 > Apple 账户 > iCloud”中释放或购买更多 iCloud 存储空间；之后同步会自动继续。"
          }
        }
      }
    },
    "sync.notice.icloudJoinAsk" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your Apple ID syncs a Devot vault. To join it with the {count} notes here, open Settings > Sync."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 Apple 账户在同步一个 Devot 保险库。要带着这里的 {count} 篇笔记加入它，请打开“设置 > 同步”。"
          }
        }
      }
    },
    "sync.notice.icloudJoined" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This device found your vault through the iCloud Keychain and joined it. Sync is on."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这台设备通过 iCloud 钥匙串找到了你的保险库并已加入。同步已打开。"
          }
        }
      }
    },
    "sync.notice.icloudKeychainMissing" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your Apple ID syncs a Devot vault, but its key has not reached this device. Join with a pairing code or the recovery key in Settings > Sync."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 Apple 账户在同步一个 Devot 保险库，但它的密钥还没有到达这台设备。请在“设置 > 同步”中用配对码或恢复密钥加入。"
          }
        }
      }
    },
    "sync.notice.icloudOtherItem" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The iCloud Keychain holds the key of another vault than the one your Apple ID syncs. Join with a pairing code or the recovery key in Settings > Sync."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud 钥匙串中保存的是另一个保险库的密钥，而不是你的 Apple 账户正在同步的那个。请在“设置 > 同步”中用配对码或恢复密钥加入。"
          }
        }
      }
    },
    "sync.notice.icloudPausedUntil" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sync paused until {time}: iCloud asked Devot to wait. Your notes keep working on this device."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同步暂停到 {time}：iCloud 要求 Devot 等待。你的笔记在这台设备上照常工作。"
          }
        }
      }
    },
    "sync.notice.icloudRestricted" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sync is paused: iCloud is restricted on this device, by Screen Time or by whoever manages it. Your notes stay on this device."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同步已暂停：这台设备上的 iCloud 受到“屏幕使用时间”或设备管理者的限制。你的笔记保留在这台设备上。"
          }
        }
      }
    },
    "sync.notice.icloudSignedOut" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sync is paused: this device is not signed in to iCloud. Sign in to iCloud in System Settings to sync again; your notes stay on this device."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同步已暂停：这台设备没有登录 iCloud。请在“系统设置”中登录 iCloud 以重新同步；你的笔记保留在这台设备上。"
          }
        }
      }
    },
    "sync.notice.icloudTemporarilyUnavailable" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud is not available right now. Sync tries again by itself; your notes keep working on this device."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud 现在不可用。同步会自动重试；你的笔记在这台设备上照常工作。"
          }
        }
      }
    },
    "sync.notice.icloudUnavailableBuild" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sync has stopped: this build of Devot cannot sync through iCloud. Turn sync off in Settings > Sync, or use a release build of Devot."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同步已停止：这个版本的 Devot 无法通过 iCloud 同步。请在“设置 > 同步”中关闭同步，或使用 Devot 的正式版本。"
          }
        }
      }
    },
    "sync.notice.licence" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sync has stopped: it needs a Devot license. Your notes stay on this device. Add a license in Settings > License."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同步已停止：它需要 Devot 许可证。你的笔记保留在这台设备上。请在“设置 > 许可证”中添加许可证。"
          }
        }
      }
    },
    "sync.notice.licenceTrialEnded" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sync has stopped: your trial has ended, and sync needs a Devot license. Your notes stay on this device. Add a license in Settings > License."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同步已停止：试用期已结束，同步需要 Devot 许可证。你的笔记保留在这台设备上。请在“设置 > 许可证”中添加许可证。"
          }
        }
      }
    },
    "sync.notice.licenceUnreadable" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sync has stopped: Devot could not read its license from the keychain. Your notes stay on this device. See Settings > License."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同步已停止：Devot 无法从钥匙串读取许可证。你的笔记保留在这台设备上。请查看“设置 > 许可证”。"
          }
        }
      }
    },
    "sync.notice.paused" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sync paused until {time}: the relay has reached its quota for today. Your notes keep working on this device and sync after that."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同步暂停到 {time}：中继已达到今天的配额。你的笔记在这台设备上照常工作，之后会同步。"
          }
        }
      }
    },
    "sync.notice.pausedUpload" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sync paused until {time}: the relay has reached its quota for today, with {sent} of {total} items uploaded. The upload goes on after that; your notes keep working on this device."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同步暂停到 {time}：中继已达到今天的配额，已上传 {sent}/{total} 项。之后上传会继续；你的笔记在这台设备上照常工作。"
          }
        }
      }
    },
    "sync.notice.resuming" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The relay’s quota for today has reset; sync resumes in a moment. Your notes keep working on this device."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "中继今天的配额已重置；同步即将恢复。你的笔记在这台设备上照常工作。"
          }
        }
      }
    },
    "sync.notice.resumingUpload" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The relay’s quota for today has reset; sync resumes in a moment, with {sent} of {total} items uploaded so far."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "中继今天的配额已重置；同步即将恢复，目前已上传 {sent}/{total} 项。"
          }
        }
      }
    },
    "sync.notice.revoked" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This device was removed from sync, so sync has stopped. Your notes stay on this device."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这台设备已从同步中移除，同步已停止。你的笔记保留在这台设备上。"
          }
        }
      }
    },
    "sync.notice.stopped" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sync has stopped. In Settings > Sync, turn Sync This Device off and on to try again, or set this device up again."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同步已停止。在“设置 > 同步”中关闭再打开“同步这台设备”以重试，或重新设置这台设备。"
          }
        }
      }
    },
    "sync.notice.stoppedAdvice" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sync has stopped. {advice}"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同步已停止。{advice}"
          }
        }
      }
    },
    "sync.notice.storageFull" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sync paused until {time}: the relay’s storage is full, so new and changed notes and images are not syncing. Notes from other devices still arrive, and everything works on this device. To sync again, remove images or notes you no longer need, or use a larger server."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同步暂停到 {time}：中继的存储空间已满，新建和修改的笔记与图片没有同步。来自其他设备的笔记仍会到达，这台设备上的一切照常工作。要再次同步，请删除不再需要的图片或笔记，或换用更大的服务器。"
          }
        }
      }
    },
    "sync.notice.storageFullRetry" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sync is trying again: the relay’s storage was full. If it pauses again, remove images or notes you no longer need, or use a larger server."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同步正在重试：中继的存储空间曾经已满。如果再次暂停，请删除不再需要的图片或笔记，或换用更大的服务器。"
          }
        }
      }
    },
    "sync.notice.tooLargeOne" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{count} note is too large to sync and stays on this device only."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有 {count} 篇笔记太大，无法同步，只保留在这台设备上。"
          }
        }
      }
    },
    "sync.notice.tooLargeOther" : {
      "extractionState" : "manual",
      "localizations" : {
