    "templates.starter.planning.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "> # !Instructions\n> State the outcome and why it matters. Break it into tasks with owners and\n> dates, and list what could go wrong.\n\n# {{title}}\n\n## Outcome\n\n## Why it matters\n\n## Tasks\n\n- [ ] \n\n## Timeline\n\n## Risks\n"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "> # !说明\n> 写明目标结果及其意义。把它拆成任务，写上负责人和日期，\n> 并列出可能出问题的地方。\n\n# {{title}}\n\n## 目标结果\n\n## 为什么重要\n\n## 任务\n\n- [ ] \n\n## 时间线\n\n## 风险\n"
          }
        }
      }
    },
