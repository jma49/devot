    "sync.restore.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merge brings back the changes your other devices made since the backup. Keep This Mac’s Copy makes the restored notes replace them on every device. Notes deleted for good on another device can’t come back either way."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“合并”会带回你的其他设备在备份之后所做的修改。“保留这台 Mac 上的副本”会让恢复的笔记在所有设备上替换它们。无论选哪个，在另一台设备上被永久删除的笔记都无法恢复。"
          }
        }
      }
    },
