      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Locks out a lost device that still has the key. Your notes move to a new vault, and your devices on this Apple ID follow on their own."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把仍持有密钥的丢失设备拒之门外。你的笔记会移到一个新保险库，这个 Apple 账户上的设备会自动跟随。"
          }
        }
      }
