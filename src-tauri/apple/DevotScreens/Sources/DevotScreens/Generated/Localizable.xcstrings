    "aiAccess.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MCP clients and AI see notes only in notebooks that allow AI access, and only notes filed directly in them. Each notebook has its own switch: a sub-notebook is not covered by its parent."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MCP 客户端和 AI 只能看到允许 AI 访问的笔记本里的笔记，而且只限直接放在这些笔记本里的笔记。每个笔记本有自己的开关：子笔记本不会跟随上级笔记本。"
          }
        }
      }
    },
