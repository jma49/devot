      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Locks out a lost or removed device that still has the key. Your notes move to a new vault, and your other devices join it again with a pairing code or the new recovery key."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
