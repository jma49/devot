    "syncSettings.filesFullOne" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{count} image is not synced: the relay has no room left for images. It stays on this device, and notes keep syncing. Remove images you no longer need, or use a larger server; it is sent again after that."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有 {count} 张图片没有同步：中继已没有存放图片的空间。它保留在这台设备上，笔记照常同步。请删除不再需要的图片，或换用更大的服务器；之后它会重新发送。"
          }
        }
      }
    },
    "syncSettings.filesFullOther" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{count} images are not synced: the relay has no room left for images. They stay on this device, and notes keep syncing. Remove images you no longer need, or use a larger server; they are sent again after that."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有 {count} 张图片没有同步：中继已没有存放图片的空间。它们保留在这台设备上，笔记照常同步。请删除不再需要的图片，或换用更大的服务器；之后它们会重新发送。"
          }
        }
      }
    },
    "syncSettings.filesOutdatedOne" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{count} image is not synced: your relay is too old to hold images. Update it: run wrangler deploy again from the new release, or restart the Node relay from it."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有 {count} 张图片没有同步：你的中继太旧，无法存放图片。请更新它：用新版本重新运行 wrangler deploy，或用新版本重启 Node 中继。"
          }
        }
      }
    },
    "syncSettings.filesOutdatedOther" : {
      "extractionState" : "manual",
