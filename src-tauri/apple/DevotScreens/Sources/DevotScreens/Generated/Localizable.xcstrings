    "activity.footnote" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Counted from the revision history. Text a note had before its history began (an import, a copy) is not counted. For days more than a week ago, a note may count only its net change over the day."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根据修订历史统计。笔记在有历史记录之前就有的文字（导入、拷贝）不计入。一周以前的日子里，一篇笔记可能只按当天的净变化计算。"
          }
        }
      }
    },
