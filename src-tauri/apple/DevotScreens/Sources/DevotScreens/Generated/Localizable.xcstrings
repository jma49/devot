          "stringUnit" : {
            "state" : "translated",
            "value" : "The vault key was changed on another device, and the new key has not reached this one through iCloud Keychain yet. To sync again, enter a pairing code from a device that has the new key, or the new recovery key. Your notes stay here."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保险库密钥已在另一台设备上更换，新密钥还没有通过 iCloud 钥匙串到达这台设备。要再次同步，请输入持有新密钥的设备上的配对码，或新的恢复密钥。你的笔记保留在这里。"
          }
        }
      }
    },
