    "syncSettings.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sync keeps your notes, notebooks, tags and images the same on your devices, through a relay you run yourself. Everything is encrypted on this device before it leaves: the relay never sees a title or a note."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同步通过你自己运行的中继，让笔记、笔记本、标签和图片在你的各台设备上保持一致。所有内容在离开这台设备之前都会加密：中继永远看不到任何标题或笔记。"
          }
        }
      }
    },
