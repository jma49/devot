        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The vault key and this device’s access to the relay are removed from this device, and sync turns off. Your notes stay here. Nothing changes on the relay or on your other devices, which list this device until you remove it there."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保险库密钥和这台设备访问中继的权限会从这台设备上移除，同步随之关闭。你的笔记保留在这里。中继和你的其他设备不会有任何变化，它们会一直列出这台设备，直到你在那里移除它。"
          }
        }
