    "templates.starter.brainstorming.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "> # !Instructions\n> Write the topic under Goal, then list every idea without judging it.\n> Group the ideas, pick the best few and give each a next step.\n\n# {{title}}\n\n## Goal\n\n## Ideas\n\n- \n\n## Groups\n\n## Next steps\n\n- [ ] \n"
          }
        }
      }
    },
    "templates.starter.brainstorming.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brainstorming"
          }
        }
      }
    },
    "templates.starter.daily-report.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "---\ntitle: Daily Report {{date}}\n---\n\n> # !Instructions\n> Fill this in at the end of the day. {{date}} is replaced with today's date\n> in each note made from this template.\n\n# {{title}}\n\n## Done today\n\n- \n\n## In progress\n\n- \n\n## Blockers\n\n- \n\n## Plan for tomorrow\n\n- [ ] \n"
          }
        }
      }
    },
    "templates.starter.daily-report.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daily Report"
          }
        }
      }
    },
    "templates.starter.debugging.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "> # !Instructions\n> Describe what you expected and what happened, then record each attempt\n> and what it showed. Finish with the cause and the fix.\n\n# {{title}}\n\n## Expected behavior\n\n## Actual behavior\n\n## Steps to reproduce\n\n1. \n\n## Attempts\n\n- \n\n## Cause\n\n## Fix\n\n- [ ] \n"
          }
        }
      }
    },
    "templates.starter.debugging.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
