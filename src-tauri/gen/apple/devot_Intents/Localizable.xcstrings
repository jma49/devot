{
  "sourceLanguage" : "en",
  "strings" : {
    "intent.add.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adds a note to Devot. It appears in your notes the next time you open Devot."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "向 Devot 添加一篇笔记。下次打开 Devot 时，它会出现在你的笔记中。"
          }
        }
      }
    },
    "intent.add.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add to Devot"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加到 Devot"
          }
        }
      }
    },
    "intent.added" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Added to Devot."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
